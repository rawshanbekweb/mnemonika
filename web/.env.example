# ── Neon Postgres ──────────────────────────────────────────────
# Neon dashboard → Connection string (pooled). "?sslmode=require" bo'lsin.
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Sessiya (JWT) imzo kaliti ──────────────────────────────────
# Tasodifiy uzun satr. Yaratish: `openssl rand -base64 32`
AUTH_SECRET="change-me-to-a-long-random-string"

# ── Birinchi admin (create-admin skripti shu bilan yaratadi) ───
ADMIN_EMAIL="admin@speakup.uz"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Administrator"

# ── Vercel Blob (rasm/media yuklash) ───────────────────────────
# Vercel → Storage → Blob → token. Lokal ishlashda ixtiyoriy.
BLOB_READ_WRITE_TOKEN=""

# ── O'quvchi natijalarini yuborishda ilova ishlatadigan token ──
# Ilova /api/attempts ga shu tokenni yuboradi (oddiy himoya).
ATTEMPTS_INGEST_TOKEN="change-me-shared-with-app"
