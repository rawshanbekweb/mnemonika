<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ovoz yozish uchun (nutq tahlili) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Model va kontent yangilanishini yuklab olish uchun -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Zaxira O'CHIRILGAN. Ilova ma'lumotlari orasida bolaning nutq transkripti
      (Room bazasi) va ismi bor — `allowBackup="true"` bo'lsa bular Google
      Drive'ga (Auto Backup) nusxalanardi, ya'ni bolalar nutqi bizning
      nazoratimizdan tashqarida uchinchi tomon serverida saqlanardi. Yo'qotish
      kichik: progress baribir serverga yuboriladi, 125MB model esa qayta
      yuklanadi (u zaxiraga tushmasligi kerak ham edi).
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpeakUp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SpeakUp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
